generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  moderator
  mechanic
  driver
}

enum UserStatus {
  active
  blocked
}

model User {
  id         String     @id @default(uuid())
  username   String     @unique
  password   String
  lastName   String
  firstName  String
  middleName String
  role       UserRole
  position   String
  status     UserStatus @default(active)
  avatar     String     @default("")
  isOnline   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  driver               Driver?
  mechanic             Mechanic?
  auditLogsTarget      AuditLog[]                 @relation("AuditTarget")
  auditLogsActor       AuditLog[]                 @relation("AuditActor")
  driverAuditTarget    DriverAuditLog[]           @relation("DriverAuditTarget")
  driverAuditActor     DriverAuditLog[]           @relation("DriverAuditActor")
  mechanicAuditTarget  MechanicAuditLog[]         @relation("MechanicAuditTarget")
  mechanicAuditActor   MechanicAuditLog[]         @relation("MechanicAuditActor")
  fleetAuditActions    FleetAuditLog[]            @relation("FleetAuditActor")
  siteAuditActions     ConstructionSiteAuditLog[] @relation("ConstructionSiteAuditActor")
  sessions             Session[]
  fleetServiceJobs     FleetServiceEvent[]        @relation("FleetServiceMechanic")
  fleetServiceReports  FleetServiceEvent[]        @relation("FleetServiceReporter")
  fleetServiceWorkLogs FleetServiceWorkLog[]      @relation("FleetServiceWorkLogAuthor")
  equipmentPlans       EquipmentPlanAssignment[]  @relation("EquipmentPlanCreatedBy")
  notificationReads    NotificationRead[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum AuditAction {
  login
  logout
  block
  unblock
  delete
  edit
  create
}

model AuditLog {
  id            String      @id @default(uuid())
  timestamp     DateTime    @default(now())
  action        AuditAction
  targetUserId  String
  targetUser    User        @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   User        @relation("AuditActor", fields: [performedById], references: [id], onDelete: Cascade)
  details       String
}

enum DrivingCategory {
  A
  B
  C
  D
  E
  BE
  CE
  DE
}

model Driver {
  id            String            @id @default(uuid())
  userId        String            @unique
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories    DrivingCategory[]
  assignedAt    DateTime          @default(now())
  documents     DriverDocument[]
  fleetVehicles FleetVehicle[]    @relation("FleetAssignedDriver")
}

enum DriverDocType {
  medical
  license
}

model DriverDocument {
  id         String        @id @default(uuid())
  driverId   String
  driver     Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type       DriverDocType
  fileName   String
  filePath   String        @default("")
  uploadedAt DateTime      @default(now())
}

enum DriverAuditAction {
  assign
  doc_upload
  doc_remove
  category_change
  unassign
}

model DriverAuditLog {
  id            String            @id @default(uuid())
  timestamp     DateTime          @default(now())
  action        DriverAuditAction
  targetUserId  String
  targetUser    User              @relation("DriverAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   User              @relation("DriverAuditActor", fields: [performedById], references: [id], onDelete: Cascade)
  details       String
}

/**
 * ── Mechanic ──
 */

enum MechanicSpecialization {
  engine
  transmission
  electrical
  suspension
  brakes
  diagnostics
  bodywork
  tire_service
}

enum MechanicDocType {
  certificate
  medical
}

model Mechanic {
  id              String                   @id @default(uuid())
  userId          String                   @unique
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations MechanicSpecialization[]
  vehicleTypes    FleetVehicleType[]       @default([])
  assignedAt      DateTime                 @default(now())
  documents       MechanicDocument[]
}

model MechanicDocument {
  id         String          @id @default(uuid())
  mechanicId String
  mechanic   Mechanic        @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  type       MechanicDocType
  fileName   String
  filePath   String          @default("")
  uploadedAt DateTime        @default(now())
}

enum MechanicAuditAction {
  assign
  doc_upload
  doc_remove
  specialization_change
  vehicle_type_change
  unassign
}

model MechanicAuditLog {
  id            String              @id @default(uuid())
  timestamp     DateTime            @default(now())
  action        MechanicAuditAction
  targetUserId  String
  targetUser    User                @relation("MechanicAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   User                @relation("MechanicAuditActor", fields: [performedById], references: [id], onDelete: Cascade)
  details       String
}

enum FleetVehicleType {
  dump_truck
  crane
  excavator
  bulldozer
  tractor
  loader
  asphalt_paver
  road_roller
  road_milling_machine
  motor_grader
  truck_tractor
  flatbed_truck
  semi_trailer
  passenger_car
  van
  pickup
}

enum FleetVehicleStatus {
  active
  reserve
  maintenance
  repair
}

enum FleetServiceEventType {
  maintenance
  inspection
  repair
  insurance
  diagnostics
}

enum FleetServiceEventStatus {
  scheduled
  in_progress
  overdue
  completed
}

enum FleetAuditAction {
  create
  edit
  delete
  status_change
  assign_driver
  unassign_driver
}

model FleetVehicle {
  id                   String             @id @default(uuid())
  name                 String
  brand                String
  model                String
  plateNumber          String             @unique
  vin                  String             @unique @default(uuid())
  type                 FleetVehicleType   @default(pickup)
  status               FleetVehicleStatus @default(active)
  previousStatus       FleetVehicleStatus @default(active)
  year                 Int                @default(2024)
  odometerKm           Int                @default(0)
  fuelLevelPercent     Int                @default(100)
  baseName             String             @default("")
  currentSite          String             @default("")
  assignedDriverUserId String?
  assignedDriver       Driver?            @relation("FleetAssignedDriver", fields: [assignedDriverUserId], references: [userId], onDelete: SetNull)
  nextMaintenanceAt    DateTime           @default(now())
  nextMaintenanceKm    Int                @default(0)
  insuranceExpiresAt   DateTime           @default(now())
  diagnosticsExpiresAt DateTime           @default(now())
  notes                String             @default("")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  serviceEvents   FleetServiceEvent[]
  auditLogs       FleetAuditLog[]
  siteAssignments SiteVehicle[]
  equipmentPlans  EquipmentPlanAssignment[]

  @@index([status])
  @@index([type])
  @@index([assignedDriverUserId])
}

model FleetServiceEvent {
  id                String                  @id @default(uuid())
  vehicleId         String
  vehicle           FleetVehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type              FleetServiceEventType
  status            FleetServiceEventStatus
  title             String
  dueAt             DateTime?
  completedAt       DateTime?
  mileageKm         Int?
  mechanicId        String?
  mechanic          User?                   @relation("FleetServiceMechanic", fields: [mechanicId], references: [id], onDelete: SetNull)
  reportedById      String?
  reporter          User?                   @relation("FleetServiceReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  defectDescription String                  @default("")
  notes             String                  @default("")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  workLogs          FleetServiceWorkLog[]

  @@index([vehicleId])
  @@index([status])
  @@index([dueAt])
  @@index([mechanicId])
  @@index([reportedById])
}

model FleetServiceWorkLog {
  id          String            @id @default(uuid())
  eventId     String
  event       FleetServiceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  performedAt DateTime
  title       String
  description String            @default("")
  mileageKm   Int?
  createdById String?
  createdBy   User?             @relation("FleetServiceWorkLogAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([eventId])
  @@index([performedAt])
  @@index([createdById])
}

model FleetAuditLog {
  id              String           @id @default(uuid())
  timestamp       DateTime         @default(now())
  action          FleetAuditAction
  targetVehicleId String?
  targetVehicle   FleetVehicle?    @relation(fields: [targetVehicleId], references: [id], onDelete: SetNull)
  vehicleLabel    String
  performedById   String
  performedBy     User             @relation("FleetAuditActor", fields: [performedById], references: [id], onDelete: Cascade)
  details         String

  @@index([timestamp])
  @@index([action])
  @@index([targetVehicleId])
}

enum ConstructionSiteAuditAction {
  create
  edit
  delete
  complete
  assign_vehicle
  unassign_vehicle
}

enum EquipmentPlanShift {
  day
  night
}

enum EquipmentPlanStatus {
  planned
  in_progress
  completed
  failed
}

enum RoadWorkStageType {
  survey
  traffic_control
  preparation
  earthworks
  milling
  tack_coat
  base_layer
  asphalt_paving
  compaction
  material_delivery
  marking
  quality_control
  maintenance
}

enum RoadWorkStageStatus {
  planned
  in_progress
  completed
  delayed
}

enum EquipmentDemandPriority {
  normal
  high
  critical
}

enum EquipmentCalculationKind {
  fixed
  per_km
  asphalt_delivery
}

model ConstructionSite {
  id              String    @id @default(uuid())
  name            String
  workType        String    @default("")
  address         String    @default("")
  latitude        Float?
  longitude       Float?
  workPeriodStart DateTime  @default(now())
  workPeriodEnd   DateTime
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicles         SiteVehicle[]
  auditLogs        ConstructionSiteAuditLog[]
  equipmentPlans   EquipmentPlanAssignment[]
  workStages       RoadWorkStage[]
  equipmentDemands EquipmentDemand[]

  @@index([isCompleted])
  @@index([workPeriodEnd])
}

model RoadWorkTypeTemplate {
  id                    String   @id @default(uuid())
  code                  String   @unique
  name                  String
  description           String   @default("")
  defaultLengthKm       Float    @default(1)
  defaultWidthM         Float    @default(7)
  defaultShiftHours     Int      @default(8)
  defaultHaulDistanceKm Float    @default(12)
  productionRateMPerDay Int      @default(750)
  sourceNote            String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  stageTemplates RoadWorkStageTemplate[]
}

model RoadWorkStageTemplate {
  id              String               @id @default(uuid())
  workTypeId      String
  workType        RoadWorkTypeTemplate @relation(fields: [workTypeId], references: [id], onDelete: Cascade)
  type            RoadWorkStageType
  name            String
  sequence        Int
  startOffsetDays Int                  @default(0)
  durationDays    Int                  @default(1)
  canOverlap      Boolean              @default(false)
  notes           String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  equipmentRules RoadWorkStageEquipmentTemplate[]

  @@index([workTypeId])
  @@index([sequence])
}

model RoadWorkStageEquipmentTemplate {
  id              String                   @id @default(uuid())
  stageTemplateId String
  stageTemplate   RoadWorkStageTemplate    @relation(fields: [stageTemplateId], references: [id], onDelete: Cascade)
  vehicleType     FleetVehicleType
  calculationKind EquipmentCalculationKind @default(fixed)
  baseCount       Int                      @default(1)
  countPerKm      Float                    @default(0)
  minCount        Int                      @default(1)
  maxCount        Int?
  plannedHours    Int                      @default(8)
  priority        EquipmentDemandPriority  @default(normal)
  notes           String                   @default("")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([stageTemplateId])
  @@index([vehicleType])
}

model SiteVehicle {
  id         String           @id @default(uuid())
  siteId     String
  site       ConstructionSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    FleetVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedAt DateTime         @default(now())

  @@unique([siteId, vehicleId])
  @@index([siteId])
  @@index([vehicleId])
}

model ConstructionSiteAuditLog {
  id            String                      @id @default(uuid())
  timestamp     DateTime                    @default(now())
  action        ConstructionSiteAuditAction
  targetSiteId  String?
  targetSite    ConstructionSite?           @relation(fields: [targetSiteId], references: [id], onDelete: SetNull)
  siteLabel     String
  performedById String
  performedBy   User                        @relation("ConstructionSiteAuditActor", fields: [performedById], references: [id], onDelete: Cascade)
  details       String

  @@index([timestamp])
  @@index([action])
  @@index([targetSiteId])
}

model EquipmentPlanAssignment {
  id           String              @id @default(uuid())
  siteId       String
  site         ConstructionSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stageId      String?
  stage        RoadWorkStage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
  demandId     String?
  demand       EquipmentDemand?    @relation(fields: [demandId], references: [id], onDelete: SetNull)
  vehicleId    String
  vehicle      FleetVehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workDate     DateTime
  shift        EquipmentPlanShift  @default(day)
  plannedHours Int
  actualHours  Int?
  status       EquipmentPlanStatus @default(planned)
  notes        String              @default("")
  createdById  String?
  createdBy    User?               @relation("EquipmentPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([vehicleId, workDate, shift])
  @@index([siteId])
  @@index([stageId])
  @@index([demandId])
  @@index([vehicleId])
  @@index([workDate])
  @@index([status])
}

model RoadWorkStage {
  id        String              @id @default(uuid())
  siteId    String
  site      ConstructionSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type      RoadWorkStageType
  name      String
  startDate DateTime
  endDate   DateTime
  status    RoadWorkStageStatus @default(planned)
  notes     String              @default("")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  equipmentDemands EquipmentDemand[]
  equipmentPlans   EquipmentPlanAssignment[]

  @@index([siteId])
  @@index([type])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model EquipmentDemand {
  id            String                  @id @default(uuid())
  siteId        String
  site          ConstructionSite        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stageId       String?
  stage         RoadWorkStage?          @relation(fields: [stageId], references: [id], onDelete: SetNull)
  vehicleType   FleetVehicleType
  requiredCount Int
  plannedHours  Int                     @default(8)
  priority      EquipmentDemandPriority @default(normal)
  notes         String                  @default("")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  equipmentPlans EquipmentPlanAssignment[]

  @@index([siteId])
  @@index([stageId])
  @@index([vehicleType])
  @@index([priority])
}

enum NotificationCategory {
  system
  security
  action
}

model Notification {
  id          String               @id @default(uuid())
  category    NotificationCategory
  title       String
  description String
  createdAt   DateTime             @default(now())

  reads NotificationRead[]

  @@index([category])
  @@index([createdAt])
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
}
